{
  "version": 1,
  "api": {
    "listen": "127.0.0.1:8090"
  },
  "runtime": {
    "docker_binary": "docker",
    "poll_interval": "2s",
    "operation_timeout": "30s",
    "readiness_timeout": "10m",
    "model_port_range": {
      "start": 8000,
      "end": 8000
    },
    "remove_on_unload": true
  },
  "models": [
    {
      "id": "qwen3-8b",
      "description": "Qwen3 8B served by vLLM",
      "image": "vllm/vllm-openai:latest",
      "command": [
        "Qwen/Qwen3-8B",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--gpu-memory-utilization", "0.90"
      ],
      "environment": {
        "HF_HOME": "/root/.cache/huggingface"
      },
      "mounts": [
        {
          "source": "/var/lib/lil-fleet/huggingface",
          "target": "/root/.cache/huggingface"
        }
      ],
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "host_port": 8000,
          "container_port": 8000
        }
      ],
      "gpus": "all",
      "shm_size": "16g",
      "ipc": "host",
      "readiness": {
        "url": "http://127.0.0.1:8000/health",
        "success_status": 200
      }
    },
    {
      "id": "mistral-7b",
      "description": "Mistral 7B served by vLLM",
      "image": "vllm/vllm-openai:latest",
      "command": [
        "mistralai/Mistral-7B-Instruct-v0.3",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--gpu-memory-utilization", "0.90"
      ],
      "environment": {
        "HF_HOME": "/root/.cache/huggingface"
      },
      "mounts": [
        {
          "source": "/var/lib/lil-fleet/huggingface",
          "target": "/root/.cache/huggingface"
        }
      ],
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "host_port": 8000,
          "container_port": 8000
        }
      ],
      "gpus": "all",
      "shm_size": "16g",
      "ipc": "host",
      "readiness": {
        "url": "http://127.0.0.1:8000/health",
        "success_status": 200
      }
    }
  ]
}
